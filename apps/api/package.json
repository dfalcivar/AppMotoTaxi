{
  "name": "@mototaxi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "test": "pnpm --filter @mototaxi/domain build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@mototaxi/domain": "workspace:*",
    "fastify": "^5.4.0",
    "postgres": "^3.4.7",
    "undici": "^8.9.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

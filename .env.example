# API local
DATABASE_URL=postgres://usuario:clave@localhost:5432/costa_go
HOST=127.0.0.1
PORT=3001
NODE_ENV=development

# Observabilidad (DSN público del proyecto Sentry correspondiente)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.05

# Servicios externos: no guardar valores reales en Git
FIREBASE_SERVICE_ACCOUNT_BASE64=
GOOGLE_MAPS_SERVER_API_KEY=
ORS_API_KEY=
# Fiscal profiles remain enabled; providers are unconfigured adapters (no electronic issuance).
FACTURACION_ENABLED=false
FACTURACION_PROVIDER=DATIL
FACTURACION_ENVIRONMENT=TEST
FACTURACION_EMAIL_MODE=PROVIDER
FACTURACION_SMTP_ENABLED=false
FACTURACION_FROM_EMAIL=
